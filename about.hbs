<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>CuantoQuedapp: third-party licenses</title>
<style>
body{font:14px/1.45 -apple-system,"Segoe UI",system-ui,sans-serif;max-width:860px;margin:2em auto;padding:0 16px;color:#1d1d1f;background:#fff}
@media(prefers-color-scheme:dark){body{color:#f5f5f7;background:#1d1d1f}a{color:#4da3ff}pre{background:#2a2a2d}}
pre{white-space:pre-wrap;background:#f2f2f5;padding:12px;border-radius:8px;font-size:12px}
li{margin:2px 0}
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>CuantoQuedapp is built with the open source crates listed below. Each one is distributed under the license shown; the source code of every crate is available from <a href="https://crates.io">crates.io</a> or the repository linked next to it.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<section>
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
